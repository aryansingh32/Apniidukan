generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RetailerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AdminRole {
  ADMIN
  OPERATIONS
  FINANCE
  SUPER_ADMIN
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  INACTIVE
}

enum SchemeType {
  ORDER_VALUE_DISCOUNT
  BUY_X_GET_Y_FREE
}

enum OrderStatus {
  PAYMENT_PENDING
  PAYMENT_VERIFICATION
  CONFIRMED
  PICKING
  PACKED
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  UTR_SUBMITTED
  UNDER_REVIEW
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  COD_PENDING
  COD_COLLECTED
}

enum PaymentMethod {
  UPI
  COD
}

model Retailer {
  id              String         @id @default(uuid())
  mobileNumber    String         @unique
  ownerName       String?
  shopName        String?
  address         String?
  city            String?
  pincode         String?
  gstin           String?
  shopPhotoUrl    String?
  status          RetailerStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  cart           Cart?
  orders         Order[]
  notifications  Notification[]
  ledgerEntries  InventoryLedgerEntry[]
  batchStocks    RetailerBatchStock[]
  expiryClaims   ExpiryClaim[]
  returnRequests ReturnRequest[]
  creditNotes    CreditNote[]
}

model OtpRequest {
  id           String   @id @default(uuid())
  mobileNumber String
  code         String
  expiresAt    DateTime
  consumed     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([mobileNumber])
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  imageUrl  String?
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id                 String        @id @default(uuid())
  name               String
  brand              String
  categoryId         String
  category           Category      @relation(fields: [categoryId], references: [id])
  imageUrl           String?
  packSize           String
  unitsPerCase       Int
  mrpPerUnit         Decimal       @db.Decimal(10, 2)
  buyingPricePerCase Decimal       @db.Decimal(10, 2)
  gstRate            Decimal       @default(18) @db.Decimal(5, 2)
  hsnCode            String?
  sku                String        @unique
  barcode            String?
  status             ProductStatus @default(ACTIVE)
  stockCases         Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  bulkPriceSlabs BulkPriceSlab[]
  schemes        Scheme[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  batches        ProductBatch[]

  @@index([categoryId])
}

model BulkPriceSlab {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minCases     Int
  maxCases     Int?
  pricePerCase Decimal @db.Decimal(10, 2)

  @@index([productId])
}

model Scheme {
  id                  String     @id @default(uuid())
  title               String
  description         String
  type                SchemeType
  minOrderValue       Decimal?   @db.Decimal(10, 2)
  discountPercent     Decimal?   @db.Decimal(5, 2)
  flatDiscount        Decimal?   @db.Decimal(10, 2)
  productId           String?
  product             Product?   @relation(fields: [productId], references: [id])
  buyQty              Int?
  freeQty             Int?
  startDate           DateTime
  endDate             DateTime
  active              Boolean    @default(true)
  imageUrl            String?
  maxUsagePerRetailer Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String
  ctaLabel  String?
  ctaTarget String?
  priority  Int       @default(0)
  startDate DateTime?
  endDate   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model DeliverySlot {
  id          String  @id @default(uuid())
  label       String
  windowStart String
  windowEnd   String
  cutoffTime  String
  active      Boolean @default(true)
  orders      Order[]
}

model Cart {
  id         String     @id @default(uuid())
  retailerId String     @unique
  retailer   Retailer   @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  caseQty   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id                    String               @id @default(uuid())
  orderNumber           String               @unique
  retailerId            String
  retailer              Retailer             @relation(fields: [retailerId], references: [id])
  items                 OrderItem[]
  subtotal              Decimal              @db.Decimal(10, 2)
  tradeDiscount         Decimal              @default(0) @db.Decimal(10, 2)
  schemeDiscount        Decimal              @default(0) @db.Decimal(10, 2)
  gstAmount             Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount           Decimal              @db.Decimal(10, 2)
  appliedSchemes        Json?
  deliverySlotId        String?
  deliverySlot          DeliverySlot?        @relation(fields: [deliverySlotId], references: [id])
  deliveryDate          DateTime?
  requiresDeliveryOtp   Boolean              @default(true)
  deliveryOtp           String?
  deliveryOtpVerifiedAt DateTime?
  status                OrderStatus          @default(PAYMENT_PENDING)
  statusHistory         OrderStatusHistory[]
  payment               Payment?
  invoice               Invoice?
  returnRequests        ReturnRequest[]
  idempotencyKey        String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product @relation(fields: [productId], references: [id])
  productNameSnapshot String
  brandSnapshot       String
  packSizeSnapshot    String
  caseQty             Int
  freeCaseQty         Int     @default(0)
  pricePerCase        Decimal @db.Decimal(10, 2)
  mrpPerUnit          Decimal @db.Decimal(10, 2)
  unitsPerCase        Int
  gstRate             Decimal @db.Decimal(5, 2)
  lineSubtotal        Decimal @db.Decimal(10, 2)
  lineDiscount        Decimal @default(0) @db.Decimal(10, 2)
  lineTotal           Decimal @db.Decimal(10, 2)

  batchAllocations OrderItemBatchAllocation[]
  returnRequests   ReturnRequest[]
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod @default(UPI)
  upiId             String?
  utr               String?
  screenshotUrl     String?
  status            PaymentStatus @default(UNPAID)
  rejectionReason   String?
  verifiedByAdminId String?
  verifiedAt        DateTime?
  submittedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

enum NotificationType {
  ORDER_CONFIRMED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  ORDER_DISPATCHED
  OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  NEW_SCHEME
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  ACCOUNT_SUSPENDED
  BROADCAST
  BATCH_EXPIRING
  BATCH_EXPIRED
  EXPIRY_CLAIM_APPROVED
  EXPIRY_CLAIM_REJECTED
  RETURN_APPROVED
  RETURN_REJECTED
}

model Notification {
  id         String           @id @default(uuid())
  retailerId String
  retailer   Retailer         @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  orderId    String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([retailerId, read])
}

// ============================================================
// Expiry traceability & claim-control system
// See EXPIRY_SYSTEM_DESIGN.md at the repo root for the full design
// rationale — this is the schema half of that document.
// ============================================================

enum BatchStatus {
  ACTIVE
  NEAR_EXPIRY
  EXPIRED
  BLOCKED
}

enum ExpiryBucket {
  HEALTHY
  INFO_180
  WARNING_90
  WARNING_60
  CRITICAL_30
  CRITICAL_7
  EXPIRED
}

enum LedgerEntryType {
  RECEIVED
  SALE
  RETURN
  TRANSFER
  ADJUSTMENT
  EXPIRED_CLAIM
  DAMAGED
  WRITE_OFF
}

enum ExpiryClaimStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CLOSED
}

enum ExpiryClaimRejectionReason {
  WRONG_BATCH
  NOT_DELIVERED
  QUANTITY_EXCEEDED
  CLAIM_WINDOW
  EVIDENCE
  DUPLICATE
  POLICY
  SUSPICIOUS
}

model ProductBatch {
  id                    String       @id @default(uuid())
  productId             String
  product               Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber           String
  manufacturingDate     DateTime?
  expiryDate            DateTime
  stockInDate           DateTime     @default(now())
  warehouseRemainingQty Int
  receivedQty           Int
  costPricePerCase      Decimal?     @db.Decimal(10, 2)
  storageRequirements   String?
  status                BatchStatus  @default(ACTIVE)
  expiryBucket          ExpiryBucket @default(HEALTHY)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  allocations   OrderItemBatchAllocation[]
  ledgerEntries InventoryLedgerEntry[]
  retailerStock RetailerBatchStock[]
  claimItems    ExpiryClaimItem[]

  @@unique([productId, batchNumber])
  @@index([expiryDate])
}

model OrderItemBatchAllocation {
  id                  String       @id @default(uuid())
  orderItemId         String
  orderItem           OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batchId             String
  batch               ProductBatch @relation(fields: [batchId], references: [id])
  caseQty             Int
  batchNumberSnapshot String
  expiryDateSnapshot  DateTime
  createdAt           DateTime     @default(now())

  @@index([orderItemId])
  @@index([batchId])
}

model InventoryLedgerEntry {
  id                 String          @id @default(uuid())
  retailerId         String
  retailer           Retailer        @relation(fields: [retailerId], references: [id])
  batchId            String
  batch              ProductBatch    @relation(fields: [batchId], references: [id])
  productId          String
  type               LedgerEntryType
  quantity           Int
  orderId            String?
  claimId            String?
  reason             String?
  performedByAdminId String?
  businessDate       DateTime        @default(now())
  createdAt          DateTime        @default(now())

  @@index([retailerId, batchId])
  @@index([batchId])
}

model RetailerBatchStock {
  id               String       @id @default(uuid())
  retailerId       String
  retailer         Retailer     @relation(fields: [retailerId], references: [id])
  batchId          String
  batch            ProductBatch @relation(fields: [batchId], references: [id])
  productId        String
  receivedQty      Int          @default(0)
  claimedQty       Int          @default(0)
  returnedQty      Int          @default(0)
  transferredQty   Int          @default(0)
  writtenOffQty    Int          @default(0)
  damagedQty       Int          @default(0)
  remainingQty     Int          @default(0)
  firstDeliveredAt DateTime?
  lastMovementAt   DateTime     @default(now())

  @@unique([retailerId, batchId])
  @@index([productId])
}

model ExpiryClaimPolicy {
  id                            String   @id @default(uuid())
  claimAllowed                  Boolean  @default(true)
  minimumExpiryAtDeliveryDays   Int      @default(90)
  claimWindowAfterExpiryDays    Int      @default(30)
  claimWindowBeforeExpiryDays   Int      @default(0)
  minimumRemainingShelfLifeDays Int      @default(60)
  requiresPhoto                 Boolean  @default(false)
  autoApproveLimitAmount        Decimal  @default(5000) @db.Decimal(10, 2)
  updatedAt                     DateTime @updatedAt
}

model ExpiryClaim {
  id                String            @id @default(uuid())
  claimNumber       String            @unique
  retailerId        String
  retailer          Retailer          @relation(fields: [retailerId], references: [id])
  status            ExpiryClaimStatus @default(SUBMITTED)
  flagged           Boolean           @default(false)
  reason            String
  evidenceUrl       String?
  totalRequestedQty Int
  totalApprovedQty  Int?
  decisionNote      String?
  decidedByAdminId  String?
  decidedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items ExpiryClaimItem[]
}

model ExpiryClaimItem {
  id                       String                      @id @default(uuid())
  claimId                  String
  claim                    ExpiryClaim                 @relation(fields: [claimId], references: [id], onDelete: Cascade)
  batchId                  String
  batch                    ProductBatch                @relation(fields: [batchId], references: [id])
  productId                String
  requestedQty             Int
  claimableQtyAtSubmission Int
  approvedQty              Int?
  unitCreditAmount         Decimal?                    @db.Decimal(10, 2)
  totalCreditAmount        Decimal?                    @db.Decimal(10, 2)
  rejectionReasonCode      ExpiryClaimRejectionReason?
}

// ============================================================
// GST invoicing
// ============================================================

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  retailerId     String
  subtotal       Decimal  @db.Decimal(10, 2)
  discountTotal  Decimal  @default(0) @db.Decimal(10, 2)
  taxableAmount  Decimal  @db.Decimal(10, 2)
  cgstAmount     Decimal  @default(0) @db.Decimal(10, 2)
  sgstAmount     Decimal  @default(0) @db.Decimal(10, 2)
  igstAmount     Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal  @db.Decimal(10, 2)
  generatedAt    DateTime @default(now())
}

// ============================================================
// Returns / Damaged Goods Claims + instant Credit Notes
// (distinct from expiry claims — this covers wrong item /
// damaged-in-transit / quality-issue returns on delivered orders)
// ============================================================

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  QUALITY_ISSUE
  EXPIRED_ON_ARRIVAL
  OTHER
}

enum ReturnStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model ReturnRequest {
  id               String        @id @default(uuid())
  returnNumber     String        @unique
  retailerId       String
  retailer         Retailer      @relation(fields: [retailerId], references: [id])
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id])
  orderItemId      String
  orderItem        OrderItem     @relation(fields: [orderItemId], references: [id])
  qty              Int
  reason           ReturnReason
  note             String?
  photoUrl         String?
  status           ReturnStatus  @default(SUBMITTED)
  rejectionReason  String?
  decidedByAdminId String?
  decidedAt        DateTime?
  creditNote       CreditNote?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([retailerId])
  @@index([orderId])
}

model CreditNote {
  id               String        @id @default(uuid())
  creditNoteNumber String        @unique
  retailerId       String
  retailer         Retailer      @relation(fields: [retailerId], references: [id])
  returnRequestId  String        @unique
  returnRequest    ReturnRequest @relation(fields: [returnRequestId], references: [id])
  amount           Decimal       @db.Decimal(10, 2)
  reason           String
  createdAt        DateTime      @default(now())

  @@index([retailerId])
}
